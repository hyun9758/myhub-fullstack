# Supabase PostgreSQL (Session pooler) 접속 정보
# Supabase 대시보드 → Project Settings → Database → Connect → Session pooler 에서 확인
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_DB_PASSWORD

# 관리자(소유자) 로그인 비밀 코드 및 세션 서명 키
# SESSION_SECRET 생성: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_PASSCODE=change-me
SESSION_SECRET=change-me-too
